{
  "manifest_version": 3,
  "name": "Vaultmarks",
  "description": "A Chromium bookmark extension that saves each bookmark as a Markdown note in your Obsidian vault — capture on desktop, read on your phone.",
  "version": "0.1.0",
  "permissions": ["activeTab", "scripting", "favicon", "storage"],
  "action": {
    "default_popup": "src/library/library.html",
    "default_title": "Vaultmarks",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
